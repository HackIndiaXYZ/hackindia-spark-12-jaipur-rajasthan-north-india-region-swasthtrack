# --- Supabase (public; safe in the browser — Row Level Security protects the data) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here

# Optional application URL (e.g. https://swasthtrack.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# --- SOIE (server-only; NEVER prefix with NEXT_PUBLIC_) ---
# Required for the LLM brain. Without it SOIE still answers from the rule-based
# engine and says so on screen.
ANTHROPIC_API_KEY=
# Optional overrides
SOIE_MODEL=claude-opus-5-5
# Set to "false" to switch internet search off.
SOIE_WEB_SEARCH=true
# Max SOIE questions per user per hour (abuse / cost guard).
SOIE_RATE_LIMIT_PER_HOUR=40
# Thinking depth (low | medium | high | xhigh | max) and request timeout in ms (10000-110000).
SOIE_EFFORT=high
SOIE_TIMEOUT_MS=100000

# --- Scripts only (scripts/import-food-dataset.js). NEVER expose to the browser or commit. ---
SUPABASE_SERVICE_ROLE_KEY=

# E-mail alerts + daily/weekly reports via Resend SMTP (server-only, never NEXT_PUBLIC_)
RESEND_API_KEY=re_your_resend_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM="SwasthTrack <onboarding@resend.dev>"
# Comma-separated recipients and the single patient these e-mails are about
REPORT_EMAIL_TO=you@example.com
REPORT_PATIENT_ID=patient-uuid-from-the-patients-table
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"; generate with: openssl rand -hex 24
CRON_SECRET=generate-a-long-random-string
# Cron mails read data as this ordinary account, added to the patient as a Viewer caregiver (no service-role key).
# Needed once the RLS migration is applied; see docs/email-notifications.md. Server only.
NOTIFY_USER_EMAIL=
NOTIFY_USER_PASSWORD=
